# Telegram MCP server environment variables.
# Copy this file to .env and fill in the values. Never commit .env.

# Telegram API credentials from https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# Telethon StringSession produced by `python scripts/login.py`.
# This is a long-lived secret: anyone holding it can act as your Telegram account.
TG_SESSION_STRING=

# Optional. Rotating file log path. Default: ~/.local/state/tg-mcp/server.log
TG_LOG_PATH=

# Optional. Logging level (DEBUG, INFO, WARNING, ERROR). Default: INFO
TG_LOG_LEVEL=INFO
